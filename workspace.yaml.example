# Specification example only. No loader or runtime is implemented.
workspace:
  id: game-planner-ai-workspace
  name: AI-Workspace
  domain: game-design
  version: 1
  default_language: zh-CN

capability_catalog:
  path: capabilities
  entries:
    - id: CAP-DOC
      contract: capabilities/document/README.md
      scope: shared-platform
      status: registered

repositories:
  - id: example-game-repository
    role: game-project
    url: https://github.com/example/example-game.git
    source_of_truth_for:
      - implementation
      - tests

projects:
  - id: example-game-project
    path: projects/example-game-project
    repository: example-game-repository
    template: projects/TEMPLATE
    status: planned

agents:
  - id: chatgpt
    ownership:
      - architecture
      - rfc
      - review
      - workflow
      - skill
  - id: codex
    ownership:
      - implementation
      - automation
      - git
      - testing
      - deployment

# Capability Discovery uses the catalog before the Host selects an implementation.
# Runtime providers and tools remain in Host configuration; this Manifest does not
# register tool endpoints, credentials, installation state, or connection status.
