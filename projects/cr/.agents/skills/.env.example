# ============================================================
# Cash Royal 数值策划 - AI 模型配置模板
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env（不要提交到版本控制）
# 2. 填入你自己的 API Key
# 3. 运行 setup_env.ps1 设置环境变量
# ============================================================

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：其他模型提供商配置
